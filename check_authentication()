def send_telegram_alert(ticker: str, details: dict) -> tuple[bool, str]:
    msg = (
        f"🚨 <b>URANIA RADAR — SEGNALE OPERATIVO</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
